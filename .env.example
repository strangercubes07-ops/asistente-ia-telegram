# Copia a tu entorno (por ejemplo en ~/.zshrc) o a un archivo que cargue iniciar-bot.command
TELEGRAM_CHAT_ID=123456789
BOT_NOMBRE=TuNombre
BOT_NOMBRE_COMPLETO="Tu Nombre Completo"
# El token del bot lo guarda el plugin de Telegram en ~/.claude/channels/telegram/.env
# Twilio: ~/claude-telegram/.twilio.env con TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_NUMERO, TWILIO_NUMERO_SID, MI_CEL
